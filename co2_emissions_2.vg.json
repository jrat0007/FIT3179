{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Air transport CO₂ emissions over time by country (OECD) with legend-based highlighting, excluding US and blank countries, plus COVID-19 line.",
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/jrat0007/FIT3179/refs/heads/main/Data/air_transport_co2_emisssions.csv"
      },
      "transform": [
        {
          "filter": "datum.Country != null && datum.Country != ''"
        }
      ],
      "params": [
        {
          "name": "countryHighlight",
          "select": {
            "type": "point",
            "fields": [
              "Country"
            ]
          },
          "bind": "legend"
        }
      ],
      "mark": "line",
      "encoding": {
        "x": {
          "field": "Year",
          "type": "temporal",
          "title": "Year",
          "axis": {
            "format": "%Y",
            "tickCount": "year"
          }
        },
        "y": {
          "field": "Air transport CO2 emissions",
          "type": "quantitative",
          "title": "CO₂ Emissions (tonnes)"
        },
        "color": {
          "field": "Country",
          "type": "nominal",
          "title": "Country",
          "legend": {
            "orient": "right",
            "columns": 1,
            "symbolLimit": 100,
            "labelFontSize": 14,
            "titleFontSize": 16
          }
        },
        "opacity": {
          "condition": {
            "param": "countryHighlight",
            "value": 1
          },
          "value": 0.2
        },
        "tooltip": [
          {
            "field": "Country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "Year",
            "type": "temporal",
            "title": "Year"
          },
          {
            "field": "Air transport CO2 emissions",
            "type": "quantitative",
            "title": "CO₂ Emissions (t)",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "year": "2020-01-01"
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "red",
        "strokeDash": [5, 5],
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "temporal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "year": "2020-01-01",
            "label": "COVID-19 impact"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": 5,
        "dy": -500,
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "red"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "temporal"
        },
        "y": {
          "datum": 0
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "fontSize": 12,
        "fontStyle": "italic",
        "color": "gray",
        "x": 885,
        "y": 20
      },
      "data": {
        "values": [
          {
            "note": "💡 Click legend to highlight, Shift+Click to select multiple"
          }
        ]
      },
      "encoding": {
        "text": {
          "field": "note"
        }
      }
    }
  ],
  "width": 900,
  "height": 600
}
